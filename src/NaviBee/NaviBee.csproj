<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>mb_NaviBee</AssemblyName>
    <RootNamespace>MusicBeePlugin</RootNamespace>
    <Authors>TaffyEx</Authors>
    <Product>NaviBee</Product>
    <Version>1.2.1</Version>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Domain\NavidromeSettings.cs" />
    <Compile Include="Domain\ConnectStream.cs" />
    <Compile Include="Domain\SubsonicModels.cs" />
    <Compile Include="Domain\SubsonicJsonParser.cs" />
    <Compile Include="Domain\SubsonicLyrics.cs" />
    <Compile Include="Services\FriendlyErrors.cs" />
    <Compile Include="Services\SubsonicClient.cs" />
    <Compile Include="Services\SubsonicClient.Queries.cs" />
    <Compile Include="Services\ArtworkCache.cs" />
    <Compile Include="Services\AudioStreamCache.cs" />
    <Compile Include="Services\LyricsCache.cs" />
    <Compile Include="Services\NavidromeCatalog.cs" />
    <Compile Include="Services\NavidromeCatalog.Storage.cs" />
    <Compile Include="Services\NavidromeCatalog.Sync.cs" />
    <Compile Include="Services\NavidromeCatalog.Index.cs" />
    <Compile Include="Services\NavidromeCatalog.LocalMatch.cs" />
    <Compile Include="Services\NavidromeCatalog.Starred.cs" />
    <Compile Include="Services\PendingSyncQueue.cs" />
    <Compile Include="Services\LocalLibraryLinker.cs" />
    <Compile Include="Services\LocalLibraryLinker.Normalize.cs" />
    <Compile Include="Services\PlaylistLinkStore.cs" />
    <Compile Include="Services\PlaylistBackup.cs" />
    <Compile Include="Services\MusicBeeArtworkBridge.cs" />
    <Compile Include="Services\MusicBeeArtworkBridge.Discovery.cs" />
    <Compile Include="Services\MusicBeeLyricsBridge.cs" />
    <Compile Include="Services\StorageIconRenderer.cs" />
    <Compile Include="Windows\SettingsWindow.cs" />
    <Compile Include="Windows\SettingsWindow.Actions.cs" />
    <Compile Include="Plugin.Lifecycle.cs" />
    <Compile Include="Plugin.Startup.cs" />
    <Compile Include="Plugin.Storage.cs" />
    <Compile Include="Plugin.Storage.Stream.cs" />
    <Compile Include="Plugin.Sync.cs" />
    <Compile Include="Plugin.LocalSync.cs" />
    <Compile Include="Plugin.StateSync.cs" />
    <Compile Include="Plugin.Playlists.cs" />
    <Compile Include="Plugin.Artwork.cs" />
    <Compile Include="MusicBeeInterface.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
